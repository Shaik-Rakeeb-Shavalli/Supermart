generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Float
  cost      Float?
  stock     Int
  barcode   String?
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportHistory {
  id             Int      @id @default(autoincrement())
  filename       String
  importedBy     String
  totalRows      Int
  successRows    Int
  failedRows     Int
  createdAt      DateTime @default(now())
  status         String
  errorReportUrl String?
  
  errors         ImportErrors[]
}

model ImportErrors {
  id           Int           @id @default(autoincrement())
  importId     Int
  rowNumber    Int
  errorMessage String
  rawData      String
  
  import       ImportHistory @relation(fields: [importId], references: [id])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique  // Razorpay Order ID
  paymentId   String?           // Razorpay Payment ID (set after verification)
  amount      Float
  status      String            // "PENDING", "SUCCESS", "FAILED"
  cashierName String
  createdAt   DateTime @default(now())
}
